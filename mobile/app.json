{
  "expo": {
    "name": "Offstage Creators",
    "slug": "offstage-creators",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "offstagecreators",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "package": "in.offstagecreators.app",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#10100F"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10100F",
          "image": "./assets/logo.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Select a payment screenshot to submit to Offstage Creators.",
          "cameraPermission": "Photograph your payment receipt.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font"
    ]
  }
}
