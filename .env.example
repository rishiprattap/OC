# ==============================================================================
# Offstage Creators — Production Environment Variables Template
# Copy this file to .env and configure real credentials.
# NEVER commit .env files containing secret values to Git!
# ==============================================================================

PORT=3000
NODE_ENV=development
APP_URL=https://offstagecreators.in

# ── Admin Panel Credentials ───────────────────────────────────────────────────
# Email used to log into the admin dashboard
ADMIN_EMAIL=admin@offstagecreators.in
# Password for admin dashboard (supports plain string or bcrypt hash)
ADMIN_PASSWORD=changeme_strong_password_here
# Shared secret for API-level admin actions / headers
ADMIN_SECRET=generate_strong_admin_secret_here

# ── Security & Cryptography ───────────────────────────────────────────────────
# Session secret for cookies (generate with: openssl rand -base64 48)
SESSION_SECRET=generate_a_random_64_char_string_here
# Keyed HMAC secret for OTP hashing & authorization tokens (openssl rand -hex 32)
OTP_SECRET=generate_a_random_32_byte_hex_secret_here

# ── Resend Custom-Domain Email (Domain: offstagecreators.in) ───────────────────
# Preferred configuration: 3 separate API keys for distinct sending streams.
# Obtain keys at https://resend.com/api-keys with sending permissions restricted to offstagecreators.in

# 1. OTP Verification (Sends from: Offstage Creators <verify@offstagecreators.in>)
RESEND_OTP_API_KEY=re_otp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Registration Confirmation (Sends from: Offstage Creators <registrations@offstagecreators.in>)
RESEND_REGISTRATION_API_KEY=re_reg_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Event Updates & Announcements (Sends from: Offstage Creators <events@offstagecreators.in>)
RESEND_EVENT_UPDATES_API_KEY=re_evt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback Resend API key (Used if any of the three above is omitted)
RESEND_API_KEY=re_default_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Local Development SMTP Fallback (Only used if no Resend key is present) ───
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Offstage Creators <registrations@offstagecreators.in>
MAIL_FROM_NAME=Offstage Creators

# ── Database (PostgreSQL / Neon) ──────────────────────────────────────────────
# Automatically populated by Vercel Neon integration.
# When offline or unset, application gracefully uses local JSON file fallback.
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgres://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Event Configuration ────────────────────────────────────────────────────────
OPEN_MIC_FEE_INR=79
