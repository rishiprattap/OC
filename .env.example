# Offstage Creators — Environment Variables Template
# Copy this to .env and fill in your real values

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Admin Credentials ──────────────────────────────────────────────────────────
# Email used to log in to the admin panel
ADMIN_EMAIL=admin@example.com
# Strong password for admin panel login
ADMIN_PASSWORD=changeme_strong_password_here

# ── Session Security ───────────────────────────────────────────────────────────
# Random 64-character string — generate with: openssl rand -base64 48
SESSION_SECRET=generate_a_random_64_char_string_here

# ── Email (Resend — required for Vercel) ─────────────────────────────────────
# Get a free API key at https://resend.com — works on Vercel (HTTPS, no SMTP blocks)
# When RESEND_API_KEY is set, it takes priority over SMTP below.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email / SMTP (local dev fallback) ────────────────────────────────────────
# Gmail SMTP (use an App Password, not your Gmail password)
# Only used locally when RESEND_API_KEY is NOT set.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=youraddress@gmail.com
MAIL_PASSWORD=your_gmail_app_password_without_spaces
MAIL_FROM=youraddress@gmail.com
MAIL_FROM_NAME=Offstage Creators

# ── Event Configuration ────────────────────────────────────────────────────────
OPEN_MIC_FEE_INR=79
