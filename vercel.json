{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/register", "destination": "/public/register.html" },
    { "source": "/registration/:id", "destination": "/public/registration.html" },
    { "source": "/registration/success", "destination": "/public/success.html" },
    { "source": "/success", "destination": "/public/success.html" },
    { "source": "/certificate", "destination": "/public/certificate.html" },
    { "source": "/scanner", "destination": "/public/scanner.html" },
    { "source": "/admin", "destination": "/public/admin.html" }
  ]
}
